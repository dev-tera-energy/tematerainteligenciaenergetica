{# ==========================================================
   Formulário de inscrição no boletim (POST nativo, sem JS).
   Parâmetro: inscrito (bool).
   ========================================================== #}
{% if inscrito %}
	<div class="rounded-2xl border border-cyan/40 bg-cyan/10 p-6.5">
		<div class="mb-2 font-display text-lg font-bold text-white">Inscrição confirmada.</div>
		<div class="text-sm leading-relaxed text-white/70">O próximo boletim chega no primeiro dia útil do mês.</div>
	</div>
{% else %}
	<form action="{{ function('admin_url', 'admin-post.php') }}" method="post">
		<input type="hidden" name="action" value="tera_boletim">
		{{ function('wp_nonce_field', 'tera_boletim') }}
		<div class="flex flex-wrap gap-3">
			<input type="email" name="email" required placeholder="seu@email.com.br" class="tera-input min-w-[240px] flex-1 border-white/[0.18] bg-white/[0.06] text-white placeholder:text-white/40">
			<button type="submit" class="tera-btn tera-btn--cyan">Assinar</button>
		</div>
		<div class="mt-3 text-[12.5px] text-white/50">Um e-mail por mês. Cancelamento em um clique.</div>
	</form>
{% endif %}
