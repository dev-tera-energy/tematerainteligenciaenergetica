{# ==========================================================
   Card de post na grade da listagem de conteúdo.
   Parâmetro: post (objeto Timber\Post).
   ========================================================== #}
<article class="tera-card tera-card--hover flex flex-col overflow-hidden rounded-[18px]">
	<a href="{{ post.link }}" class="block">
		{% if post.thumbnail %}
			<img src="{{ post.thumbnail.src('tera-card') }}" alt="{{ post.thumbnail.alt|default(post.title) }}" class="h-[130px] w-full border-b border-slate-200 object-cover">
		{% else %}
			<div class="flex h-[130px] items-center justify-center border-b border-slate-200 bg-green-tint">
				<span class="font-mono text-[11px] uppercase tracking-[0.1em] text-green-700/60">⬡ {{ post.category.title|default('Tera') }}</span>
			</div>
		{% endif %}
	</a>
	<div class="flex flex-1 flex-col p-[20px_22px_22px]">
		<div class="mb-3 flex items-center gap-2.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-slate-500">
			<span class="text-green-700">{{ post.category.title|default('Tera') }}</span>
			<span>·</span>
			<span>{{ post.content|leitura }} min</span>
		</div>
		<h3 class="mb-2 text-[17px] font-bold leading-[1.3] tracking-[-0.02em] text-balance">
			<a href="{{ post.link }}">{{ post.title }}</a>
		</h3>
		<p class="mb-3.5 text-[13.5px] leading-relaxed text-slate-500">{{ post.preview.length(18).read_more(false) }}</p>
		<div class="mt-auto font-mono text-[10.5px] tracking-wide text-slate-400">{{ post.date('d M Y')|upper }}</div>
	</div>
</article>
