{# ==========================================================
   Etapa numerada do método (trilha horizontal).
   Parâmetro: etapa ({badge, titulo, texto}).
   ========================================================== #}
<div class="tera-step">
	<div class="tera-step__line"></div>
	<div class="tera-step__dot"></div>
	<div class="tera-step__n">{{ etapa.badge }}</div>
	<h3>{{ etapa.titulo }}</h3>
	<p>{{ etapa.texto }}</p>
</div>
