{% extends 'base.twig' %}
{% block content %}

<article>
	<header class="pt-14">
		<div class="wrap grid max-w-[1080px] grid-cols-1 gap-15 lg:grid-cols-[1fr_260px]">
			<div>
				<div class="mb-5.5 flex items-center gap-2.5 font-mono text-[11.5px] uppercase tracking-[0.08em] text-muted">
					<a href="{{ blog_url }}" class="text-green-700">Conteúdo</a>
					<span>/</span>
					<span>{{ categoria.title|default('Artigo') }}</span>
				</div>
				<h1 class="text-balance mb-5 text-[42px] font-extrabold leading-[1.1] tracking-[-0.03em]">{{ post.title }}</h1>
				{% if post.preview.text %}
					<p class="text-pretty text-lg leading-relaxed text-body">{{ post.preview.length(28).read_more(false) }}</p>
				{% endif %}
			</div>
			<div class="flex flex-col gap-4 border-l border-slate-200 pl-6.5">
				<div>
					<div class="mb-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Publicado</div>
					<div class="text-sm font-semibold">{{ post.date('d M Y') }}</div>
				</div>
				<div>
					<div class="mb-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Leitura</div>
					<div class="text-sm font-semibold">{{ leitura }} minutos</div>
				</div>
				<div>
					<div class="mb-1 font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Autor</div>
					<div class="text-sm font-semibold">{{ post.author.name }}</div>
				</div>
			</div>
		</div>
	</header>

	{% if post.thumbnail %}
		<div class="wrap max-w-[820px] pt-9 pb-4">
			<img src="{{ post.thumbnail.src('tera-hero') }}" alt="{{ post.thumbnail.alt|default(post.title) }}" class="h-[280px] w-full rounded-[20px] border border-slate-200 object-cover">
		</div>
	{% endif %}

	<div class="prose-tera wrap max-w-[820px] pb-20">
		{{ post.content }}
	</div>

	<section class="bg-green py-15">
		<div class="wrap max-w-[820px]">
			{% include 'partials/eyebrow.twig' with { texto: 'Próximo passo', on_dark: true } %}
			<h2 class="text-balance mt-4 mb-3.5 text-[32px] font-bold leading-[1.15] tracking-[-0.025em] text-white">Quer saber se você paga por energia desperdiçada?</h2>
			<p class="mb-6.5 max-w-[60ch] text-base leading-relaxed text-[#9fd6c8]">Envie as faturas dos últimos doze meses. O diagnóstico inicial identifica as oportunidades de economia, sem custo e sem compromisso.</p>
			<div class="flex flex-wrap gap-3.5">
				<a href="{{ contato_url }}" class="tera-btn tera-btn--cyan">Quero um diagnóstico <span class="arr">→</span></a>
				{% if boletim_ativo %}
					<a href="{{ boletim_url }}" class="tera-btn tera-btn--ghost-dark">Assinar o boletim</a>
				{% endif %}
			</div>
		</div>
	</section>

	{% if relacionados|length %}
	<section class="section pt-17.5 pb-20">
		<div class="wrap">
			<div class="mb-8 flex items-center justify-between gap-6">
				<h2 class="text-[26px] font-bold tracking-[-0.025em]">Continue lendo</h2>
				<a href="{{ blog_url }}" class="tera-btn tera-btn--ghost tera-btn--sm">Ver tudo</a>
			</div>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
				{% for relacionado in relacionados %}
					<a href="{{ relacionado.link }}" class="tera-card tera-card--hover rounded-[18px] p-[22px]">
						<div class="mb-2.5 font-mono text-[11px] uppercase tracking-[0.08em] text-green-700">{{ relacionado.category.title|default('Tera') }}</div>
						<h3 class="text-pretty mb-2 text-[17px] font-bold leading-[1.3] tracking-[-0.02em]">{{ relacionado.title }}</h3>
						<div class="font-mono text-[10.5px] tracking-[0.06em] text-subtle">{{ relacionado.content|leitura }} min</div>
					</a>
				{% endfor %}
			</div>
		</div>
	</section>
	{% endif %}
</article>

{% endblock %}
